generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  createdRooms     Room[]           @relation("RoomCreator")
  roomParticipants RoomParticipant[] @relation("RoomParticipant")
  codeExecutions   CodeExecution[]  @relation("CodeExecution")

  @@map("users")
}

model Room {
  id           String   @id @default(uuid())
  name         String
  description  String?
  language     String   @default("javascript")
  visibility   Boolean  @default(true)
  password     String?
  code         String   @default("") @db.Text
  input        String   @default("") @db.Text
  output       String   @default("") @db.Text
  maxCapacity  Int      @default(10) @map("max_capacity")
  creatorId    String   @map("creator_id")
  creator      User     @relation("RoomCreator", fields: [creatorId], references: [id])
  participants RoomParticipant[]
  executions   CodeExecution[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  lastActivity DateTime @default(now()) @map("last_activity")

  @@map("rooms")
}

model RoomParticipant {
  id            String   @id @default(uuid())
  roomId        String   @map("room_id")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation("RoomParticipant", fields: [userId], references: [id])
  cursorLine    Int      @default(0) @map("cursor_line")
  cursorColumn  Int      @default(0) @map("cursor_column")
  status        String   @default("active")
  joinedAt      DateTime @default(now()) @map("joined_at")
  lastActivity  DateTime @default(now()) @map("last_activity")
  
  @@unique([roomId, userId])
  @@map("room_participants")
}

model CodeExecution {
  id            String   @id @default(uuid())
  roomId        String   @map("room_id")
  room          Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  user          User     @relation("CodeExecution", fields: [userId], references: [id])
  code          String   @db.Text
  language      String
  output        String?  @db.Text
  error         String?  @db.Text
  executionTime Int?     @map("execution_time")
  status        String
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("code_executions")
}